  {
    "id": "switch_router",
    "type": "switch",
    "z": "tab_semana05",
    "name": "Roteador por Tópico/Tipo",
    "property": "topic",
    "propertyType": "msg",
    "rules": [
      {
        "t": "cont",
        "v": "telemetria",
        "vt": "str"
      },
