        "t": "cont",
        "v": "alarmes",
        "vt": "str"
      },
      {
        "t": "cont",
        "v": "producao",
        "vt": "str"
      },
      {
        "t": "else"
      }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 4,
    "x": 550,
    "y": 200,
    "wires": [
      [
        "fn_telemetria"
      ],
      [
        "fn_alarme"
      ],
      [
        "fn_producao"
      ],
      [
        "debug_outros"
      ]
    ]
  },
  {
    "id": "fn_telemetria",
    "type": "function",
    "z": "tab_semana05",
    "name": "Tratamento de Telemetria",
    "func": "const payload = msg.payload || {};\nconst temp = payload.temperatura || 0;\nconst vib = payload.vibracao || 0;\nconst pressao = payload.pressao || 0;\n\n// Avaliação de Criticidade\nlet statusGeral = \"NORMAL\";\nlet cor = \"#28a745\"; // Verde\n\nif (temp > 80 || vib > 7.0) {\n    statusGeral = \"CRÍTICO\";\n    cor = \"#dc3545\"; // Vermelho\n} else if (temp > 65 || vib > 4.5) {\n    statusGeral = \"ALERTA\";\n    cor = \"#ffc107\"; // Amarelo\n}\n\nmsg.status_geral = statusGeral;\nmsg.cor_status = cor;\nmsg.payload_formatado = `[${payload.maquina || 'MAQ_01'}] Temp: ${temp.toFixed(1)}°C | Vib: ${vib.toFixed(2)} mm/s | Pressão: ${pressao.toFixed(1)} bar -> Status: ${statusGeral}`;\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 810,
    "y": 120,
    "wires": [
      [
        "debug_telemetria"
      ]
    ]
  },
  {
    "id": "fn_alarme",
    "type": "function",
    "z": "tab_semana05",
    "name": "Formatador de Alarmes Críticos",
    "func": "const payload = msg.payload || {};\n\nmsg.prioridade = \"MÁXIMA\";\nmsg.payload_alarme = {\n    tipo: payload.tipo || \"ALARME_GERAL\",\n    origem: payload.origem || msg.topic,\n    mensagem: payload.mensagem || \"Evento de emergência detectado!\",\n    timestamp: payload.timestamp || new Date().toISOString(),\n    acao_recomendada: payload.acao || \"Verificar imediatamente o painel da máquina\"\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 830,
    "y": 180,
    "wires": [
      [
        "debug_alarme"
      ]
    ]
  },
  {
    "id": "fn_producao",
    "type": "function",
    "z": "tab_semana05",
    "name": "Processador de Produção",
    "func": "const payload = msg.payload || {};\nconst total = payload.total_produzido || 0;\nconst boas = payload.pecas_boas || total;\nconst refugo = payload.refugo || (total - boas);\nconst taxaAprovacao = total > 0 ? ((boas / total) * 100).toFixed(1) : 100.0;\n\nmsg.resumo_producao = {\n    maquina: payload.maquina || \"LINHA_01\",\n    total_produzido: total,\n    pecas_boas: boas,\n    refugo: refugo,\n    taxa_qualidade: `${taxaAprovacao}%`\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 820,
    "y": 240,
    "wires": [
      [
        "debug_producao"
      ]
    ]
  },
